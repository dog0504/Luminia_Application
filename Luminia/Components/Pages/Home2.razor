@page "/"

<PageTitle>Luminia - 利用形態選択</PageTitle>

<div class="bg-slate-50 text-slate-800 min-h-screen relative overflow-x-hidden selection:bg-indigo-100 selection:text-indigo-900 font-sans">

    <div class="fixed inset-0 z-0 pointer-events-none">
        <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=1920" class="w-full h-full object-cover opacity-50" alt="Background">
        <div class="absolute inset-0 bg-gradient-to-b from-white/60 via-white/40 to-slate-50/90"></div>
    </div>

    <header class="relative z-20 w-full glass-panel sticky top-0 transition-all duration-300 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center gap-3 cursor-pointer group" @onclick="ReloadPage">
                <div class="p-2 bg-gradient-to-br from-indigo-600 to-purple-600 rounded-lg text-white shadow-lg group-hover:shadow-indigo-500/30 transition-all duration-300 group-hover:scale-105">
                    <span class="material-symbols-outlined text-2xl">all_inclusive</span>
                </div>
                <span class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-slate-800 to-slate-600 tracking-tight">Luminia</span>
            </div>
            
            <button @onclick="ToggleDevTools" class="group flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-600 bg-white/80 border border-slate-200 rounded-full hover:bg-slate-800 hover:text-white hover:border-slate-800 transition-all shadow-sm hover:shadow-md active:scale-95">
                <span class="material-symbols-outlined text-[20px] group-hover:animate-pulse">terminal</span>
                <span class="hidden sm:inline">開発者ツール</span>
            </button>
        </div>
    </header>

    <main class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20 flex flex-col items-center">
        
        <div class="text-center mb-16 max-w-3xl mx-auto animate-fade-in-up" style="animation-delay: 0.1s;">
            <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6 tracking-tight leading-tight">
                ご利用形態を選択してください
            </h1>
            <p class="text-slate-500 text-lg md:text-xl font-light">
                Luminiaは、企業の採用課題と個人のキャリア形成を<br class="hidden sm:block">
                最先端のAI技術でシームレスにつなぎます。
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 w-full max-w-6xl px-2">
            
            <div id="card-dispatcher" class="group relative bg-white rounded-[2rem] shadow-xl hover:shadow-2xl hover:shadow-indigo-500/10 transition-all duration-500 border border-slate-100 overflow-hidden flex flex-col h-full transform hover:-translate-y-2 animate-fade-in-up" style="animation-delay: 0.2s;">
                <div class="h-56 overflow-hidden relative">
                    <div class="absolute inset-0 bg-indigo-900/10 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
                    <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&q=80&w=800" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" alt="Dispatcher Dashboard">
                    <div class="absolute top-6 left-6 z-20">
                        <span class="bg-white/90 backdrop-blur text-indigo-700 text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider shadow-sm border border-indigo-100">
                            Enterprise
                        </span>
                    </div>
                </div>
                
                <div class="p-8 lg:p-10 flex-1 flex flex-col">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="p-3 bg-indigo-50 rounded-2xl text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-300 shadow-sm">
                            <span class="material-symbols-outlined text-3xl">domain</span>
                        </div>
                        <h2 class="text-2xl font-bold text-slate-800">派遣元向け</h2>
                    </div>
                    <p class="text-slate-500 mb-8 leading-relaxed">
                        人材リソースの可視化とマッチング精度向上により、<br>営業利益の最大化を実現します。
                    </p>
                    <ul class="space-y-4 mb-10 flex-1">
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-indigo-500 mt-0.5 shrink-0">check_circle</span>
                            <span class="text-slate-700 font-medium">候補者管理の一元化・効率化</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-indigo-500 mt-0.5 shrink-0">check_circle</span>
                            <span class="text-slate-700 font-medium">AIによるTCD（適性）補正</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-indigo-500 mt-0.5 shrink-0">check_circle</span>
                            <span class="text-slate-700 font-medium">高精度な求人マッチング自動化</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-indigo-500 mt-0.5 shrink-0">check_circle</span>
                            <span class="text-slate-700 font-medium">部署メンバーの稼働状況可視化</span>
                        </li>
                    </ul>
                    <button @onclick="OpenDispatcherModal" class="w-full py-4 bg-slate-50 hover:bg-indigo-600 text-slate-700 hover:text-white font-bold rounded-xl border border-slate-200 hover:border-indigo-600 transition-all duration-300 flex items-center justify-center gap-2 group-hover:shadow-lg active:scale-[0.98]">
                        <span>派遣元として利用する</span>
                        <span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">arrow_forward</span>
                    </button>
                </div>
            </div>

            <div id="card-client" class="group relative bg-white rounded-[2rem] shadow-xl hover:shadow-2xl hover:shadow-emerald-500/10 transition-all duration-500 border border-slate-100 overflow-hidden flex flex-col h-full transform hover:-translate-y-2 animate-fade-in-up" style="animation-delay: 0.3s;">
                <div class="h-56 overflow-hidden relative">
                    <div class="absolute inset-0 bg-emerald-900/10 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
                    <img src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&q=80&w=800" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" alt="Client Collaboration">
                    <div class="absolute top-6 left-6 z-20">
                        <span class="bg-white/90 backdrop-blur text-emerald-700 text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider shadow-sm border border-emerald-100">
                            Client
                        </span>
                    </div>
                </div>
                
                <div class="p-8 lg:p-10 flex-1 flex flex-col">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="p-3 bg-emerald-50 rounded-2xl text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-300 shadow-sm">
                            <span class="material-symbols-outlined text-3xl">storefront</span>
                        </div>
                        <h2 class="text-2xl font-bold text-slate-800">派遣先向け</h2>
                    </div>
                    <p class="text-slate-500 mb-8 leading-relaxed">
                        プロジェクトに最適な即戦力人材を<br>スピーディーに確保できます。
                    </p>
                    <ul class="space-y-4 mb-10 flex-1">
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-emerald-500 mt-0.5 shrink-0">check_circle</span>
                            <span class="text-slate-700 font-medium">要件を満たす候補者の自動推薦</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-emerald-500 mt-0.5 shrink-0">check_circle</span>
                            <span class="text-slate-700 font-medium">スキル・経歴の直感的な比較</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-emerald-500 mt-0.5 shrink-0">check_circle</span>
                            <span class="text-slate-700 font-medium">面談調整・契約プロセスの効率化</span>
                        </li>
                        <li aria-hidden="true" class="flex items-start gap-3 opacity-0 select-none">
                            <span class="material-symbols-outlined mt-0.5">circle</span>
                            <span>Spacer</span>
                        </li>
                    </ul>
                    <button @onclick='() => StartLoading("client")' class="w-full py-4 bg-slate-50 hover:bg-emerald-600 text-slate-700 hover:text-white font-bold rounded-xl border border-slate-200 hover:border-emerald-600 transition-all duration-300 flex items-center justify-center gap-2 group-hover:shadow-lg active:scale-[0.98]">
                        <span>派遣先として利用する</span>
                        <span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">arrow_forward</span>
                    </button>
                </div>
            </div>

        </div>

        <p class="mt-16 text-slate-400 text-sm font-medium">
            © 2026 Luminia Inc. All rights reserved.
        </p>
    </main>

    @if (_isDispatcherModalOpen)
    {
        <div class="fixed inset-0 z-50 transition-opacity duration-300" role="dialog" aria-modal="true">
            <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity animate-fade-in" @onclick="CloseDispatcherModal"></div>
            
            <div class="absolute inset-0 flex items-center justify-center p-4 sm:p-6 overflow-y-auto custom-scroll pointer-events-none">
                <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl transform transition-all duration-300 pointer-events-auto flex flex-col max-h-[90vh] animate-scale-up">
                    
                    <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50 rounded-t-2xl backdrop-blur-xl sticky top-0 z-10">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-indigo-600 text-2xl">all_inclusive</span>
                            <span class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-indigo-600 to-purple-600 tracking-tight">Luminia</span>
                        </div>
                        <button @onclick="CloseDispatcherModal" class="text-slate-400 hover:text-slate-600 transition-colors p-2 hover:bg-slate-100 rounded-full">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>

                    <div class="p-6 sm:p-8 overflow-y-auto custom-scroll">
                        <div class="mb-8 text-center">
                            <h2 class="text-2xl font-bold text-slate-800 mb-2">派遣元企業 新規登録</h2>
                            <div class="inline-flex items-center gap-2 px-3 py-1 bg-indigo-50 text-indigo-700 text-sm font-medium rounded-full border border-indigo-100">
                                <span class="material-symbols-outlined text-sm">domain</span>
                                派遣元企業としてご登録いただきます
                            </div>
                        </div>

                        <EditForm Model="_registrationModel" OnValidSubmit="HandleRegistration" class="space-y-6">
                            <DataAnnotationsValidator />
                            
                            <div class="space-y-4">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-1">企業名 <span class="text-red-500">*</span></label>
                                        <InputText @bind-Value="_registrationModel.CompanyName" placeholder="例: 株式会社ルミニア" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400" />
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-1">企業名（カナ／英語）</label>
                                        <InputText @bind-Value="_registrationModel.CompanyNameEn" placeholder="例: Luminia Inc." class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400" />
                                    </div>
                                </div>
                                
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">法人番号 <span class="text-xs text-slate-400 font-normal">（任意・推奨）</span></label>
                                    <InputText @bind-Value="_registrationModel.CorporateNumber" placeholder="13桁の法人番号を入力" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400" />
                                </div>
                            </div>

                            <div class="pt-4 border-t border-slate-100">
                                <h3 class="text-sm font-semibold text-slate-900 mb-4 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-slate-400 text-lg">location_on</span>
                                    所在地情報
                                </h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-1">都道府県 <span class="text-red-500">*</span></label>
                                        <InputSelect @bind-Value="_registrationModel.Prefecture" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-white text-slate-700">
                                            <option value="">選択してください</option>
                                            <option value="tokyo">東京都</option>
                                            <option value="osaka">大阪府</option>
                                            <option value="aichi">愛知県</option>
                                            <option value="fukuoka">福岡県</option>
                                            <option value="hokkaido">北海道</option>
                                            <option value="other">その他</option>
                                        </InputSelect>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-1">市区町村 <span class="text-red-500">*</span></label>
                                        <InputText @bind-Value="_registrationModel.City" placeholder="例: 渋谷区" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400" />
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">丁目・番地・建物名 <span class="text-red-500">*</span></label>
                                    <InputText @bind-Value="_registrationModel.Address" placeholder="例: 神南1-1-1 ルミニアビル 8F" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400" />
                                </div>
                            </div>

                            <div class="pt-4 border-t border-slate-100">
                                <h3 class="text-sm font-semibold text-slate-900 mb-4 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-slate-400 text-lg">contact_mail</span>
                                    連絡先情報
                                </h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-1">電話番号 <span class="text-xs text-slate-400 font-normal">（任意・推奨）</span></label>
                                        <InputText @bind-Value="_registrationModel.PhoneNumber" placeholder="03-1234-5678" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400" />
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-slate-700 mb-1">代表メールアドレス <span class="text-red-500">*</span></label>
                                        <InputText @bind-Value="_registrationModel.Email" placeholder="admin@example.com" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400" />
                                        <p class="text-xs text-slate-500 mt-1">※このアドレス宛に認証メールが送信されます。</p>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-6">
                                <button type="submit" class="w-full py-4 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-bold rounded-xl shadow-lg hover:shadow-indigo-500/30 transition-all transform active:scale-[0.99] flex items-center justify-center gap-2">
                                    <span>上記の内容で登録する</span>
                                    <span class="material-symbols-outlined">arrow_forward</span>
                                </button>
                            </div>
                        </EditForm>
                    </div>

                    <div class="px-6 py-6 bg-slate-50 border-t border-slate-100 rounded-b-2xl flex flex-col items-center gap-4">
                        <a href="#" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium hover:underline transition-colors flex items-center gap-1">
                            すでにアカウントをお持ちの方はこちら（ログイン）
                            <span class="material-symbols-outlined text-sm">login</span>
                        </a>
                        
                        <div class="flex items-center gap-4 text-xs text-slate-400">
                            <a href="#" class="hover:text-slate-600 hover:underline">利用規約</a>
                            <span>|</span>
                            <a href="#" class="hover:text-slate-600 hover:underline">プライバシーポリシー</a>
                        </div>
                        
                        <div class="mt-2 opacity-50 flex items-center gap-1.5 grayscale hover:grayscale-0 transition-all duration-500">
                            <span class="material-symbols-outlined text-indigo-600 text-lg">all_inclusive</span>
                            <span class="text-sm font-bold text-slate-700 tracking-tight">Luminia</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_isDevToolsOpen)
    {
        <div class="fixed inset-0 z-50 transition-opacity duration-300" role="dialog" aria-modal="true">
            <div class="absolute inset-0 bg-black/70 backdrop-blur-sm animate-fade-in" @onclick="ToggleDevTools"></div>
            <div class="absolute inset-4 md:inset-10 lg:inset-x-20 lg:inset-y-16 bg-[#1e1e1e] rounded-xl shadow-2xl flex flex-col overflow-hidden border border-slate-700 transform transition-transform duration-300 animate-scale-up">
                <div class="flex items-center justify-between px-6 py-4 bg-[#252526] border-b border-[#3e3e3e]">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-blue-400">code</span>
                        <h3 class="text-slate-200 font-mono text-sm font-semibold tracking-wide">Home.razor (Component Structure)</h3>
                    </div>
                    <div class="flex items-center gap-3">
                        <button class="flex items-center gap-2 px-4 py-2 text-xs font-bold text-slate-200 bg-indigo-600 hover:bg-indigo-500 rounded transition-all shadow-lg hover:shadow-indigo-500/30 active:translate-y-0.5">
                            <span class="material-symbols-outlined text-[18px]">content_copy</span>
                            <span>コードをコピー (Demo)</span>
                        </button>
                        <div class="w-px h-6 bg-slate-600 mx-1"></div>
                        <button @onclick="ToggleDevTools" class="text-slate-400 hover:text-white transition-colors p-1 hover:bg-slate-700 rounded">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                </div>
                <div class="flex-1 overflow-auto custom-scroll dark-scroll relative bg-[#1e1e1e] p-6 group">
                    <pre class="text-xs sm:text-sm font-mono leading-relaxed text-[#d4d4d4] select-all">
                        <code>
                            &lt;!-- Blazor Component Structure --&gt;
                            &lt;EditForm Model="_registrationModel" ...&gt;
                                &lt;!-- Form fields --&gt;
                            &lt;/EditForm&gt;
                            ...
                        </code>
                    </pre>
                </div>
            </div>
        </div>
    }

    @if (_isLoading)
    {
        <div class="fixed inset-0 z-[60] bg-white flex flex-col items-center justify-center transition-opacity duration-500 animate-fade-in">
            <div class="relative w-24 h-24 mb-6">
                <div class="absolute inset-0 border-4 border-slate-100 rounded-full"></div>
                <div class="@(_loadingType == "dispatcher" ? "border-indigo-600" : "border-emerald-500") absolute inset-0 border-4 rounded-full border-t-transparent animate-spin transition-colors duration-300"></div>
                <span class="@(_loadingType == "dispatcher" ? "text-indigo-600" : "text-emerald-600") material-symbols-outlined absolute inset-0 m-auto text-4xl flex items-center justify-center animate-pulse transition-colors duration-300">all_inclusive</span>
            </div>
            <h2 class="@(_loadingType == "dispatcher" ? "text-indigo-700" : "text-emerald-700") text-2xl font-bold animate-pulse transition-colors duration-300">
                @(_loadingType == "dispatcher" ? "登録処理を実行中..." : "派遣先ポータルへ移動中...")
            </h2>
            <p class="text-slate-500 mt-2 font-medium">Luminiaを起動中... 安全な接続を確立しています</p>
        </div>
    }

</div>

<style>
    /* Custom Styles for Blazor Component */
    .glass-panel {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(226, 232, 240, 0.8);
    }
    
    /* Animations */
    .animate-fade-in-up {
        animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
        transform: translateY(20px);
    }
    /* keyframes fadeInUp {
        to { opacity: 1; transform: translateY(0); }
    } */

    .animate-fade-in {
        animation: fadeIn 0.3s ease-out forwards;
        opacity: 0;
    }
    /* keyframes fadeIn {
        to { opacity: 1; }
    } */

    .animate-scale-up {
        animation: scaleUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
        transform: scale(0.95);
    }
    /* keyframes scaleUp {
        to { opacity: 1; transform: scale(1); }
    } */

    /* Scrollbars */
    .custom-scroll::-webkit-scrollbar { width: 8px; height: 8px; }
    .custom-scroll::-webkit-scrollbar-track { background: rgba(0,0,0,0.05); }
    .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    .custom-scroll::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    
    .dark-scroll::-webkit-scrollbar-track { background: #1e1e1e; }
    .dark-scroll::-webkit-scrollbar-thumb { background: #555; }
</style>

@code {
    private bool _isDispatcherModalOpen = false;
    private bool _isDevToolsOpen = false;
    private bool _isLoading = false;
    private string _loadingType = "dispatcher";
    private RegistrationModel _registrationModel = new();

    private class RegistrationModel
    {
        public string CompanyName { get; set; } = "";
        public string CompanyNameEn { get; set; } = "";
        public string CorporateNumber { get; set; } = "";
        public string Prefecture { get; set; } = "";
        public string City { get; set; } = "";
        public string Address { get; set; } = "";
        public string PhoneNumber { get; set; } = "";
        public string Email { get; set; } = "";
    }

    private void ReloadPage()
    {
        // Blazor way to force refresh or navigate to home
        // NavigationManager.NavigateTo("/", true);
    }

