    private async Task StartLoading(string type)
    {
        _loadingType = type;
        _isLoading = true;
        StateHasChanged(); // Force re-render

        await Task.Delay(2000); // Simulate network latency

        if (type == "client")
        {
            // await JSRuntime.InvokeVoidAsync("alert", "派遣先(Client) モードとしてログインしました。");
        }
        
        _isLoading = false;
        StateHasChanged();
    }
