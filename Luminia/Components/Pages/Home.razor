@page "/"
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luminia - 利用形態選択</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,1,0">

    <style>
        /* ベースフォント設定 */
        body {
            font-family: 'Inter', 'Noto Sans JP', sans-serif;
        }

        /* ガラスモーフィズムパネル */
        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.5);
        }

        /* コードモーダル用アニメーション */
        .code-modal-enter {
            opacity: 0;
            transform: scale(0.95);
        }
        .code-modal-enter-active {
            opacity: 1;
            transform: scale(1);
            transition: opacity 300ms ease-out, transform 300ms ease-out;
        }
        .code-modal-exit {
            opacity: 1;
            transform: scale(1);
        }
        .code-modal-exit-active {
            opacity: 0;
            transform: scale(0.95);
            transition: opacity 200ms ease-in, transform 200ms ease-in;
        }

        /* カスタムスクロールバー */
        .custom-scroll::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        .custom-scroll::-webkit-scrollbar-track {
            background: #1e1e1e;
        }
        .custom-scroll::-webkit-scrollbar-thumb {
            background: #555;
            border-radius: 4px;
        }
        .custom-scroll::-webkit-scrollbar-thumb:hover {
            background: #777;
        }

        /* フェードインアニメーション定義 */
        @keyframes fade-in-up {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-up {
            animation: fade-in-up 0.8s ease-out forwards;
        }
    </style>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans JP', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen relative overflow-x-hidden selection:bg-indigo-100 selection:text-indigo-900">

    <div class="fixed inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=1920" alt="Background" class="w-full h-full object-cover opacity-60">
        <div class="absolute inset-0 bg-white/40"></div>
    </div>

    <header class="relative z-20 w-full glass-panel sticky top-0">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2 cursor-pointer transition-transform hover:scale-105" onclick="window.location.reload()">
                <span class="material-symbols-outlined text-indigo-600 text-3xl">all_inclusive</span>
                <span class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-indigo-600 to-purple-600 tracking-tight">Luminia</span>
            </div>

            <button onclick="toggleDevTools()" class="group flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-200 rounded-full hover:bg-slate-800 hover:text-white hover:border-slate-800 transition-all shadow-sm">
                <span class="material-symbols-outlined text-[20px] group-hover:animate-pulse">code</span>
                <span class="hidden sm:inline">ソースコードを表示</span>
            </button>
        </div>
    </header>

    <main class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 flex flex-col items-center">

        <div class="text-center mb-12 max-w-2xl mx-auto animate-fade-in-up">
            <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4 tracking-tight">
                ご利用形態を選択してください
            </h1>
            <p class="text-slate-500 text-lg">
                あなたの役割に合わせた最適な環境をご用意します。
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 w-full max-w-5xl">

            <div id="card-dispatcher" class="group relative bg-white rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-300 border border-slate-100 overflow-hidden flex flex-col h-full transform hover:-translate-y-1">
                <div class="h-48 overflow-hidden relative">
                    <div class="absolute inset-0 bg-indigo-900/10 group-hover:bg-transparent transition-colors z-10"></div>
                    <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&q=80&w=800" alt="Dispatcher Dashboard" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700">
                    <div class="absolute top-4 left-4 z-20 bg-indigo-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-md">
                        For Enterprise
                    </div>
                </div>

                <div class="p-8 flex-1 flex flex-col">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="p-3 bg-indigo-50 rounded-xl text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined text-3xl">domain</span>
                        </div>
                        <h2 class="text-2xl font-bold text-slate-800">派遣元向け</h2>
                    </div>

                    <p class="text-slate-500 text-sm mb-6 border-b border-slate-100 pb-4">
                        人材管理と営業活動をAIで最適化し、業務効率を最大化します。
                    </p>

                    <ul class="space-y-4 mb-8 flex-1">
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-indigo-500 mt-0.5">group_add</span>
                            <span class="text-slate-700 font-medium">候補者管理の効率化</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-indigo-500 mt-0.5">radio_button_unchecked</span>
                            <span class="text-slate-700 font-medium">AI TCD補正機能</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-indigo-500 mt-0.5">handshake</span>
                            <span class="text-slate-700 font-medium">求人マッチングの自動化</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-indigo-500 mt-0.5">online_prediction</span>
                            <span class="text-slate-700 font-medium">部署メンバーのオンライン状況可視化</span>
                        </li>
                    </ul>

                    <button onclick="selectMode('dispatcher')" class="w-full py-4 bg-slate-50 hover:bg-indigo-600 text-slate-700 hover:text-white font-bold rounded-xl border border-slate-200 hover:border-indigo-600 transition-all duration-300 flex items-center justify-center gap-2 group-hover:shadow-lg">
                        <span>派遣元として利用する</span>
                        <span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">arrow_forward_ios</span>
                    </button>
                </div>
            </div>

            <div id="card-client" class="group relative bg-white rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-300 border border-slate-100 overflow-hidden flex flex-col h-full transform hover:-translate-y-1">
                <div class="h-48 overflow-hidden relative">
                    <div class="absolute inset-0 bg-emerald-900/10 group-hover:bg-transparent transition-colors z-10"></div>
                    <img src="https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&q=80&w=800" alt="Client Collaboration" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700">
                    <div class="absolute top-4 left-4 z-20 bg-emerald-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-md">
                        For Client
                    </div>
                </div>

                <div class="p-8 flex-1 flex flex-col">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="p-3 bg-emerald-50 rounded-xl text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined text-3xl">storefront</span>
                        </div>
                        <h2 class="text-2xl font-bold text-slate-800">派遣先向け</h2>
                    </div>

                    <p class="text-slate-500 text-sm mb-6 border-b border-slate-100 pb-4">
                        最適な人材を素早く見つけ、面談から採用までをスムーズに。
                    </p>

                    <ul class="space-y-4 mb-8 flex-1">
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-emerald-500 mt-0.5">recommend</span>
                            <span class="text-slate-700 font-medium">スキル条件を満たす候補者推薦</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-emerald-500 mt-0.5">dashboard_customize</span>
                            <span class="text-slate-700 font-medium">スキル・経歴の見やすいUI</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-emerald-500 mt-0.5">calendar_add_on</span>
                            <span class="text-slate-700 font-medium">面談調整のスムーズ化</span>
                        </li>
                        <li class="flex items-start gap-3 opacity-0" aria-hidden="true">
                            <span class="material-symbols-outlined text-emerald-500 mt-0.5">circle</span>
                            <span class="text-slate-700 font-medium">Spacer</span>
                        </li>
                    </ul>

                    <button onclick="selectMode('client')" class="w-full py-4 bg-slate-50 hover:bg-emerald-600 text-slate-700 hover:text-white font-bold rounded-xl border border-slate-200 hover:border-emerald-600 transition-all duration-300 flex items-center justify-center gap-2 group-hover:shadow-lg">
                        <span>派遣先として利用する</span>
                        <span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">arrow_forward_ios</span>
                    </button>
                </div>
            </div>

        </div>

        <p class="mt-12 text-slate-400 text-sm">
            © 2024 Luminia Inc. All rights reserved.
        </p>
    </main>

    <div id="devtools-modal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity" onclick="toggleDevTools()"></div>

        <div class="absolute inset-4 md:inset-10 bg-[#1e1e1e] rounded-xl shadow-2xl flex flex-col overflow-hidden border border-slate-700 transform transition-all" id="devtools-content">

            <div class="flex items-center justify-between px-6 py-4 bg-[#252526] border-b border-[#3e3e3e]">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-blue-400">code</span>
                    <h3 class="text-slate-200 font-mono text-sm font-semibold">index.html - Source Viewer</h3>
                </div>
                <div class="flex items-center gap-3">
                    <button onclick="copyCode()" class="flex items-center gap-1 px-3 py-1.5 text-xs text-slate-300 bg-slate-700 hover:bg-slate-600 rounded transition-colors" id="copy-btn">
                        <span class="material-symbols-outlined text-[16px]">content_copy</span>
                        <span>コピー</span>
                    </button>
                    <button onclick="toggleDevTools()" class="text-slate-400 hover:text-white transition-colors">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
            </div>

            <div class="flex-1 overflow-auto custom-scroll relative bg-[#1e1e1e] p-6">
                <pre class="text-xs sm:text-sm font-mono leading-relaxed text-[#d4d4d4]"><code id="code-display"></code></pre>
            </div>
        </div>
    </div>

    <div id="loading-overlay" class="fixed inset-0 z-[60] bg-white hidden flex flex-col items-center justify-center">
        <div class="relative w-24 h-24 mb-6">
            <div class="absolute inset-0 border-4 border-slate-100 rounded-full"></div>
            <div class="absolute inset-0 border-4 border-indigo-600 rounded-full border-t-transparent animate-spin"></div>
            <span class="material-symbols-outlined absolute inset-0 m-auto text-indigo-600 text-4xl flex items-center justify-center animate-pulse">all_inclusive</span>
        </div>
        <h2 id="loading-text" class="text-2xl font-bold text-slate-800 animate-pulse">Luminiaを起動中...</h2>
        <p class="text-slate-500 mt-2">安全な接続を確立しています</p>
    </div>

    <script>
        // --- DevTools Logic (with animations) ---
        function toggleDevTools() {
            const modal = document.getElementById('devtools-modal');
            const content = document.getElementById('devtools-content');
            const codeDisplay = document.getElementById('code-display');

            if (modal.classList.contains('hidden')) {
                // Open Modal
                const htmlContent = document.documentElement.outerHTML;
                codeDisplay.textContent = htmlContent;

                modal.classList.remove('hidden');
                // Apply enter animation classes
                content.classList.remove('code-modal-exit', 'code-modal-exit-active');
                content.classList.add('code-modal-enter');

                // Force reflow
                void content.offsetWidth;

                content.classList.add('code-modal-enter-active');
                content.classList.remove('code-modal-enter');

            } else {
                // Close Modal with animation
                content.classList.remove('code-modal-enter', 'code-modal-enter-active');
                content.classList.add('code-modal-exit');

                void content.offsetWidth;

                content.classList.add('code-modal-exit-active');
                content.classList.remove('code-modal-exit');

                // Wait for animation to finish before hiding
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 200);
            }
        }

        function copyCode() {
            const code = document.documentElement.outerHTML;
            navigator.clipboard.writeText(code).then(() => {
                const btn = document.getElementById('copy-btn');
                const originalContent = btn.innerHTML;

                btn.classList.replace('bg-slate-700', 'bg-green-700');
                btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">check</span><span>コピー完了</span>';

                setTimeout(() => {
                    btn.classList.replace('bg-green-700', 'bg-slate-700');
                    btn.innerHTML = originalContent;
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy text: ', err);
            });
        }

        // --- Selection Logic ---
        function selectMode(type) {
            const loader = document.getElementById('loading-overlay');
            const loadText = document.getElementById('loading-text');
            const spinner = loader.querySelector('.animate-spin');

            // Customize loading screen based on selection
            if (type === 'dispatcher') {
                loadText.innerText = "派遣元ダッシュボードへ移動中...";
                spinner.classList.replace('border-emerald-500', 'border-indigo-600');
                loadText.classList.remove('text-emerald-700');
                loadText.classList.add('text-indigo-700');
            } else {
                loadText.innerText = "派遣先ポータルへ移動中...";
                spinner.classList.replace('border-indigo-600', 'border-emerald-500');
                loadText.classList.remove('text-indigo-700');
                loadText.classList.add('text-emerald-700');
            }

            // Show loader
            loader.classList.remove('hidden');
            loader.classList.add('flex');

            // Simulate loading delay then redirect (simulation)
            setTimeout(() => {
                alert(`${type === 'dispatcher' ? '派遣元(Enterprise)' : '派遣先(Client)'} モードとしてログインしました。\n(デモ画面のため、リロードして戻ります)`);
                location.reload();
            }, 2000);
        }
    </script>
</body>
</html>