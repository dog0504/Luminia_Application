@page "/home2"
@inject IJSRuntime JSRuntime

<style>
    .glass-panel {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .animate-in {
        animation: fadeIn 0.3s ease-out forwards;
    }

    .slide-up {
        animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes slideUp {
        from {
            transform: translateY(20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
</style>

<div class="luminia-container font-sans text-slate-900 bg-slate-50 h-screen w-full overflow-hidden relative">

    <header class="absolute top-0 left-0 w-full z-40 p-6 flex justify-between items-center pointer-events-none">
        <div class="flex items-center gap-2 pointer-events-auto cursor-pointer" @onclick="ResetApp">
            <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center text-white font-bold text-lg shadow-lg">L</div>
            <span class="text-xl font-bold tracking-tight text-slate-800 drop-shadow-sm bg-white/80 px-2 rounded-md backdrop-blur-sm">Luminia</span>
        </div>

        <div class="pointer-events-auto flex items-center gap-3">
            <button class="text-sm font-medium text-slate-500 hover:text-blue-600 transition-colors bg-white/80 px-3 py-1.5 rounded-full backdrop-blur-sm shadow-sm border border-slate-200"
                    @onclick='() => ShowAlert("サポートセンターへのお問い合わせフォームを開きます")'>
                お問い合わせ
            </button>
        </div>
    </header>

    <main class="flex flex-col md:flex-row h-full w-full relative">

        <section class="group relative w-full md:w-1/2 h-1/2 md:h-full overflow-hidden bg-gradient-to-br from-blue-700 via-blue-600 to-indigo-700 text-white flex flex-col items-center justify-center p-8 md:p-12 transition-all duration-500 hover:md:w-[55%]">
            <div class="absolute inset-0 opacity-20 mix-blend-overlay">
                <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=80&w=1080" alt="Network" class="w-full h-full object-cover">
            </div>
            <div class="absolute inset-0 bg-blue-900/10 z-0"></div>

            <div class="relative z-10 max-w-md text-center md:text-left slide-up" style="animation-delay: 0.1s;">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-500/30 border border-blue-400/30 text-xs font-medium mb-6 backdrop-blur-sm">
                    <span class="material-symbols-outlined text-[16px]">psychology</span>
                    <span>For Staffing Agencies</span>
                </div>
                <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight leading-tight">
                    次世代の<br>人材派遣管理を。
                </h2>
                <p class="text-blue-100 text-lg mb-8 leading-relaxed">
                    AIマッチングとCRMの統合により、<br>候補者選定から契約管理までを劇的に効率化します。
                </p>

                <ul class="space-y-3 mb-10 text-left">
                    <li class="flex items-center gap-3">
                        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-500 text-white shadow-sm">
                            <span class="material-symbols-outlined text-[14px]">check</span>
                        </span>
                        <span class="font-medium text-blue-50">AIによる最適人材の自動マッチング</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-500 text-white shadow-sm">
                            <span class="material-symbols-outlined text-[14px]">check</span>
                        </span>
                        <span class="font-medium text-blue-50">リアルタイムな案件進捗管理 (CRM)</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-500 text-white shadow-sm">
                            <span class="material-symbols-outlined text-[14px]">check</span>
                        </span>
                        <span class="font-medium text-blue-50">複雑な契約書・請求書の自動生成</span>
                    </li>
                </ul>

                <button @onclick='() => OpenAuthModal("agency")' class="group/btn w-full md:w-auto inline-flex items-center justify-center gap-2 bg-white text-blue-600 hover:bg-blue-50 px-8 py-4 rounded-xl font-bold shadow-lg shadow-blue-900/20 transition-all transform hover:-translate-y-1">
                    <span>派遣元として利用する</span>
                    <span class="material-symbols-outlined transition-transform group-hover/btn:translate-x-1">arrow_forward</span>
                </button>
                <div class="mt-6 text-sm text-blue-200">
                    すでにアカウントをお持ちの方は
                    <button @onclick='() => OpenAuthModal("agency", "login")' class="text-white underline underline-offset-4 hover:text-blue-100 bg-transparent border-0 p-0 inline">ログイン</button>
                </div>
            </div>
        </section>

        <section class="group relative w-full md:w-1/2 h-1/2 md:h-full overflow-hidden bg-slate-50 flex flex-col items-center justify-center p-8 md:p-12 border-l border-slate-200 transition-all duration-500 hover:md:w-[55%]">
            <div class="absolute inset-0 opacity-5 mix-blend-multiply pointer-events-none">
                <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=1080" alt="Office" class="w-full h-full object-cover">
            </div>

            <div class="relative z-10 max-w-md text-center md:text-left slide-up text-slate-900" style="animation-delay: 0.2s;">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-200 text-slate-600 text-xs font-medium mb-6">
                    <span class="material-symbols-outlined text-[16px]">business_center</span>
                    <span>For Client Companies</span>
                </div>
                <h2 class="text-3xl md:text-5xl font-bold mb-4 tracking-tight leading-tight text-slate-900">
                    即戦力を、<br>必要なその瞬間に。
                </h2>
                <p class="text-slate-600 text-lg mb-8 leading-relaxed">
                    24時間いつでも依頼可能。<br>スキルセットに基づいた透明性の高い人材検索。
                </p>

                <ul class="space-y-3 mb-10 text-left">
                    <li class="flex items-center gap-3">
                        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-slate-200 text-slate-700">
                            <span class="material-symbols-outlined text-[14px]">search</span>
                        </span>
                        <span class="font-medium text-slate-700">スキル条件で即戦力を検索</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-slate-200 text-slate-700">
                            <span class="material-symbols-outlined text-[14px]">send</span>
                        </span>
                        <span class="font-medium text-slate-700">3ステップで簡単求人依頼</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-slate-200 text-slate-700">
                            <span class="material-symbols-outlined text-[14px]">visibility</span>
                        </span>
                        <span class="font-medium text-slate-700">候補者プロフィール・動画閲覧</span>
                    </li>
                </ul>

                <button @onclick='() => OpenAuthModal("client")' class="group/btn w-full md:w-auto inline-flex items-center justify-center gap-2 bg-slate-900 text-white hover:bg-slate-800 px-8 py-4 rounded-xl font-bold shadow-xl shadow-slate-200 transition-all transform hover:-translate-y-1">
                    <span>派遣先として利用する</span>
                    <span class="material-symbols-outlined transition-transform group-hover/btn:translate-x-1">arrow_forward</span>
                </button>
                <div class="mt-6 text-sm text-slate-500">
                    すでにアカウントをお持ちの方は
                    <button @onclick='() => OpenAuthModal("client", "login")' class="text-blue-600 underline underline-offset-4 hover:text-blue-700 bg-transparent border-0 p-0 inline">ログイン</button>
                </div>
            </div>
        </section>
    </main>

    @if (isModalOpen)
    {
        <div class="fixed inset-0 z-50" role="dialog" aria-modal="true">
            <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" @onclick="CloseAuthModal"></div>

            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg p-4">
                <div class="bg-white rounded-2xl shadow-2xl overflow-hidden animate-in @(authMode == "login" ? " " : "flex flex-col h-[600px]") ">
                    <div class="bg-slate-50 px-8 py-6 border-b border-slate-100 flex justify-between items-center">
                        <div>
                            <h3 class="text-xl font-bold text-slate-900">@(authMode == "login" ? "ログイン" : "新規登録")</h3>
                            <p class="text-sm text-slate-500 mt-1">
                                @(userType == "agency" ? "派遣元アカウント" : "派遣先アカウント")
                            </p>
                        </div>
                        <button @onclick="CloseAuthModal" class="text-slate-400 hover:text-slate-600 p-2 rounded-full hover:bg-slate-100 transition-colors">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>

                    <div class="flex border-b border-slate-100">
                        <button @onclick='() => SwitchTab("login")' class="flex-1 py-4 text-sm font-medium transition-colors border-b-2 @(authMode == "login" ? "text-blue-600 border-blue-600 bg-blue-50/50" : "text-slate-500 border-transparent")">
                           ログイン
                        </button>
                        <button @onclick='() => SwitchTab("signup")' class="flex-1 py-4 text-sm font-medium transition-colors border-b-2 @(authMode == "signup" ? "text-blue-600 border-blue-600 bg-blue-50/50" : "text-slate-500 border-transparent")">
                            新規登録
                        </button>
                    </div>

                    <div class="p-8 overflow-y-auto custom-scroll">
                        @if (userType == "agency" && authMode == "signup")
                        {
                            <div class="mb-6 p-4 rounded-lg bg-blue-50 border border-blue-100 flex gap-3">
                                <span class="material-symbols-outlined text-blue-600 shrink-0">info</span>
                                <div class="text-sm text-blue-800">
                                    <span class="font-bold block mb-0.5">派遣元アカウント作成</span>
                                    企業情報の入力が必要です。
                                </div>
                            </div>
                        }
                        @if(userType == "client" && authMode == "singup")
                        {
                            <div class="mb-6 p-4 rounded-lg bg-blue-50 border border-blue-100 flex gap-3">
                                <span class="material-symbols-outlined text-blue-600 shrink-0">info</span>
                                <div class="text-sm text-blue-800">
                                    <span class="font-bold block mb-0.5">派遣先アカウント作成</span>
                                    企業情報の入力が必要です。
                                </div>
                            </div>
                        }

                        <form @onsubmit="HandleAuthSubmit">
                            <div class="space-y-4">
                                @if ((userType == "client" && authMode == "login") || (userType == "agency" && authMode == "login"))
                                {
                                    <div class="space-y-2">
                                        <label class="text-sm font-medium leading-none">メールアドレス</label>
                                        <input type="email" @bind="email" placeholder="name@@company.com" required class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="text-sm font-medium leading-none">パスワード</label>
                                        <input type="password" @bind="password" placeholder="••••••••" required class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
                                    </div>
                                }


                                @if ((userType == "client" && authMode == "signup") || (userType == "agency" && authMode == "signup"))
                                {
                                    <div class="space-y-2">
                                        <label class="text-sm font-medium leading-none">メールアドレス</label>
                                        <input type="email" @bind="email" placeholder="name@@company.com" required class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="text-sm font-medium leading-none">認証確認</label>
                                        <input type="text" @bind="email_confirm" placeholder="549372" required class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="text-sm font-medium leading-none">パスワード</label>
                                        <input type="password" @bind="password" placeholder="••••••••" required class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="text-sm font-medium leading-none">パスワード確認</label>
                                        <input type="password" @bind="password_confirm" placeholder="••••••••" required class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus-ring:-2 focus:ring-blue-600"/>
                                    </div>
                                    <div class="space-y-4 border-t border-dashed border-slate-200 pt-4 mt-2">
                                        <div class="grid grid-cols-2 gap-4">

                                            <div class="space-y-2 col-span-2">
                                                <label class="text-sm font-medium">企業名 <span class="text-red-500 text-xs">*必須</span></label>
                                                <input type="text" placeholder="株式会社Luminia" class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
                                            </div>

                                            <div class="space-y-2 col-span-2">
                                                <label class="text-sm font-medium">法人番号 <span class="text-slate-400 text-xs">(任意)</span></label>
                                                <input type="text" placeholder="1234567890123" class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
                                            </div>

                                            <div class="space-y-2">
                                                <label class="text-sm font-medium">都道府県 <span class="text-red-500 text-xs">*</span></label>
                                                <input type="text" placeholder="東京都" class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
                                            </div>
                                            <div class="space-y-2">
                                                <label class="text-sm font-medium">市区町村 <span class="text-red-500 text-xs">*</span></label>
                                                <input type="text" placeholder="渋谷区" class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
                                            </div>

                                            <div class="space-y-2 col-span-2">
                                                <label class="text-sm font-medium">丁目・番地 <span class="text-red-500 text-xs">*</span></label>
                                                <input type="text" placeholder="神南1-2-3" class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
                                            </div>
                                        </div>
                                    </div>
                                }


                                <button type="submit" disabled="@isSubmitting" class="w-full inline-flex items-center justify-center rounded-md text-sm font-medium bg-blue-600 text-white hover:bg-blue-700 h-11 px-8 mt-6 disabled:opacity-50">
                                    @if (isSubmitting)
                                    {
                                        <span class="material-symbols-outlined animate-spin mr-2">refresh</span>
                                        <span>処理中...</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined mr-2 text-[18px]">@(authMode == "login" ? "login" : "person_add")</span>
                                        <span>@(authMode == "login" ? "ログイン" : "アカウント作成")</span>
                                    }
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showToast)
    {
        <div class="fixed bottom-4 right-4 z-50 animate-in">
            <div class="bg-slate-900 text-white px-6 py-4 rounded-lg shadow-lg flex items-center gap-3">
                <span class="material-symbols-outlined text-green-400">check_circle</span>
                <div>
                    <h4 class="font-bold text-sm">Success</h4>
                    <p class="text-xs text-slate-300">@toastMessage</p>
                </div>
            </div>
        </div>
    }

</div>

@code {
    // --- State Management (C#) ---
    private bool isModalOpen = false;
    private string userType = "client"; // "agency" or "client"
    private string authMode = "login";  // "login" or "signup"
    private string email = "";
    private string password = "";
    private string email_confirm = "";
    private string password_confirm = "";

    // UI State
    private bool isSubmitting = false;
    private bool showToast = false;
    private string toastMessage = "";

    // --- Actions ---

    private void OpenAuthModal(string type, string mode = "login")
    {
        userType = type;
        SwitchTab(mode);
        isModalOpen = true;

        // ログインモードならモックデータを入れる（デモ用）
        if (mode == "login")
        {
            email = type == "agency" ? "recruiter@staffing.co.jp" : "hr@client-corp.com";
        }
        else
        {
            email = "";
            password = "";
        }
    }

    private void CloseAuthModal()
    {
        isModalOpen = false;
    }

    private void ResetApp()
    {
        CloseAuthModal();
        userType = "client";
    }

    private void SwitchTab(string mode)
    {
        authMode = mode;
    }

    private async Task HandleAuthSubmit()
    {
        isSubmitting = true;

        // API通信のシミュレーション (1.5秒待機)
        await Task.Delay(1500);

        isSubmitting = false;
        isModalOpen = false;

        var roleText = userType == "agency" ? "派遣元" : "派遣先";
        var actionText = authMode == "login" ? "ログイン" : "登録";
        ShowToast($"{roleText}として{actionText}しました。");

        // ここで実際の画面遷移を行う (例: NavigationManager.NavigateTo("/dashboard"))
    }

    private void ShowToast(string message)
    {
        toastMessage = message;
        showToast = true;

        // 4秒後に消す
        Task.Delay(4000).ContinueWith(_ =>
        {
            showToast = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task ShowAlert(string message)
    {
        await JSRuntime.InvokeVoidAsync("alert", message);
    }
}